<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/panel_card_focused" />
            <stroke android:width="2.5dp" android:color="@color/accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/accent_glow" />
            <stroke android:width="2dp" android:color="@color/focus" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/panel" />
            <stroke android:width="1dp" android:color="#22334A" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
