<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/panel_card_focused" />
            <stroke android:width="2.5dp" android:color="@color/focus_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/panel_card_focused" />
            <stroke android:width="2.5dp" android:color="@color/focus_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/panel_card" />
            <stroke android:width="1dp" android:color="#1A253A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
