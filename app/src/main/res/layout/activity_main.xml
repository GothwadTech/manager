<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingTop="18dp"
    android:paddingRight="24dp"
    android:paddingBottom="14dp">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- App Logo & Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/badge_box"
                android:gravity="center"
                android:text="GM"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:text="TV File Hub"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Storage Drive Overview Pill (Focusable & Clickable) -->
        <LinearLayout
            android:id="@+id/button_storage_drive"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginLeft="16dp"
            android:background="@drawable/storage_pill_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💾"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_storage_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/internal_storage"
                    android:textColor="@color/text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progress_storage"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="100dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="45"
                    android:progressDrawable="@drawable/progress_bar_storage" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_storage_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- TV Action Buttons -->
        <Button
            android:id="@+id/button_search"
            style="@style/ActionButton"
            android:text="🔍 Search" />

        <Button
            android:id="@+id/button_sort"
            style="@style/ActionButton"
            android:text="⇅ Sort" />

        <Button
            android:id="@+id/button_categories"
            style="@style/ActionButton"
            android:text="⊞ Media" />

        <Button
            android:id="@+id/button_apps"
            style="@style/ActionButton"
            android:text="📦 Apps" />

        <Button
            android:id="@+id/button_cleaner"
            style="@style/ActionButton"
            android:text="🧹 Clean" />

        <Button
            android:id="@+id/button_dual_pane"
            style="@style/ActionButton"
            android:text="🔲 Dual" />

        <Button
            android:id="@+id/button_toolbox"
            style="@style/ActionButton"
            android:text="⚡ Tools" />

        <Button
            android:id="@+id/button_multiselect"
            style="@style/ActionButton"
            android:text="☑ Select" />

        <Button
            android:id="@+id/button_new_folder"
            style="@style/ActionButton"
            android:text="📁 +Dir" />

        <Button
            android:id="@+id/button_transfer"
            style="@style/PrimaryActionButton"
            android:text="📡 Transfer" />

    </LinearLayout>

    <!-- Path & Filter Breadcrumbs Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/badge_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📁"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/text_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/button_bookmark_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:text="⭐"
            android:textColor="@color/accent"
            android:textSize="15sp" />

        <!-- Filter / Search active indicator -->
        <LinearLayout
            android:id="@+id/layout_filter_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_filter_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_clear_filter"
                style="@style/DangerActionButton"
                android:layout_height="28dp"
                android:minWidth="60dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="✕ Clear"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Area: ListView and Empty View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/file_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:drawSelectorOnTop="false"
            android:listSelector="@android:color/transparent" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/badge_pill"
                android:gravity="center"
                android:text="📂"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/empty_directory"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Press Remote Transfer to upload files from your phone"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Batch Actions Bar (Visible in Multi-Select Mode) -->
    <LinearLayout
        android:id="@+id/layout_batch_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_batch_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/button_batch_select_all"
            style="@style/ActionButton"
            android:text="@string/select_all" />

        <Button
            android:id="@+id/button_batch_copy"
            style="@style/ActionButton"
            android:text="📋 Copy" />

        <Button
            android:id="@+id/button_batch_move"
            style="@style/ActionButton"
            android:text="✂ Move" />

        <Button
            android:id="@+id/button_batch_zip"
            style="@style/ActionButton"
            android:text="🗜 ZIP" />

        <Button
            android:id="@+id/button_batch_delete"
            style="@style/DangerActionButton"
            android:text="🗑 Delete" />

        <Button
            android:id="@+id/button_batch_exit"
            style="@style/ActionButton"
            android:text="@string/exit_multiselect" />
    </LinearLayout>

    <!-- Bottom Remote Control Helper Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/remote_key_badge"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:text="▲▼"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="Navigate"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:background="@drawable/remote_key_badge"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:text="OK"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="Open"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:background="@drawable/remote_key_badge"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:text="Long OK"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="Delete"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:background="@drawable/remote_key_badge"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:text="MENU"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="Copy/Cut/Rename"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
