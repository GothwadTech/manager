<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔲"
            android:textSize="24sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:text="@string/dual_pane"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_dual_copy"
            style="@style/ActionButton"
            android:text="📋 Copy to Other" />

        <Button
            android:id="@+id/button_dual_move"
            style="@style/ActionButton"
            android:text="✂ Move to Other" />

        <Button
            android:id="@+id/button_dual_exit"
            style="@style/ActionButton"
            android:text="Exit Dual Pane" />
    </LinearLayout>

    <!-- Two Panes Side by Side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Pane -->
        <LinearLayout
            android:id="@+id/container_left_pane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/card_panel"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/text_left_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:singleLine="true"
                android:text="/storage/emulated/0"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/list_left_pane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:divider="@android:color/transparent"
                android:dividerHeight="4dp" />
        </LinearLayout>

        <!-- Right Pane -->
        <LinearLayout
            android:id="@+id/container_right_pane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/card_panel"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/text_right_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:singleLine="true"
                android:text="/storage/emulated/0/Download"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/list_right_pane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:divider="@android:color/transparent"
                android:dividerHeight="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Helper -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:text="Press Left/Right Arrow on remote to switch active pane · OK to Open · BACK to Parent Directory"
        android:textColor="@color/muted"
        android:textSize="11sp" />

</LinearLayout>
